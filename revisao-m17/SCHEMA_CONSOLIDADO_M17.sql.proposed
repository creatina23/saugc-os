  created_at timestamptz NOT NULL DEFAULT now()
);
ALTER TABLE public.briefings ENABLE ROW LEVEL SECURITY;
ALTER TABLE public.briefings FORCE ROW LEVEL SECURITY;
REVOKE ALL ON TABLE public.briefings FROM PUBLIC, anon, authenticated;
CREATE INDEX briefings_user_created_idx ON public.briefings (user_id, created_at DESC);
