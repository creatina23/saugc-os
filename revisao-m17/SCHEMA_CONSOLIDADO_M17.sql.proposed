-- CONSOLIDADO M17: banco Supabase local NOVO, com schemas geridos ja inicializados.
-- Nao e migration de upgrade de banco existente. Nao sobrescreve dados ou schema.
-- Comentarios historicos dos modulos sao mantidos; a autorizacao vale so no laboratorio.
-- Os tres GUCs exigidos sao travas de acidente, NAO comprovam isolamento.
-- Nao define as travas automaticamente. Verificar daemon, DB, rede e baseline fora do SQL.
-- Aplicar de forma atomica: nenhuma janela com apenas T10 visivel a outros clientes.
BEGIN;
-- MODULO: SCHEMA_T10.sql.proposed
-- PROPOSTA T10: nao executada. Somente Supabase LOCAL novo e descartavel.
-- Decisoes de produto aprovadas; execucao ainda NAO autorizada.
-- Trava contra acidente: nao prova consentimento nem identifica o ambiente.
DO $review$
BEGIN
  IF current_setting('anuncia.t10_review', true) IS DISTINCT FROM 'REVIEWED_LOCAL_ONLY' THEN
    RAISE EXCEPTION 'T10: exige autorizacao separada e verificacao do alvo LOCAL';
  END IF;
  IF current_user <> 'postgres' OR NOT EXISTS (
    SELECT 1 FROM pg_catalog.pg_roles WHERE rolname=current_user AND (rolsuper OR rolbypassrls)
  ) THEN
    RAISE EXCEPTION 'T10: revisar o executor local; esperado postgres com bypass de RLS';
  END IF;
END
$review$;

-- CREATE SCHEMA/TABLE falham se ja houver recursos: nao sobrescrever schema desconhecido.
DO $roles_guard$
BEGIN
  IF EXISTS (SELECT 1 FROM pg_catalog.pg_roles AS api CROSS JOIN pg_catalog.pg_roles AS elevated
    WHERE api.rolname IN ('anon','authenticated') AND (elevated.rolsuper OR elevated.rolbypassrls)
      AND pg_catalog.pg_has_role(api.oid,elevated.oid,'MEMBER')) THEN
    RAISE EXCEPTION 'Roles API nao podem ser superuser ou BYPASSRLS';
  END IF;
END
$roles_guard$;
CREATE SCHEMA anuncia_private;
REVOKE ALL ON SCHEMA anuncia_private FROM PUBLIC, anon, authenticated;
-- sem CREATE para roles de API; somente objetos declarados abaixo recebem grants.
REVOKE CREATE ON SCHEMA public FROM PUBLIC, anon, authenticated;
GRANT USAGE ON SCHEMA public TO authenticated;

CREATE FUNCTION anuncia_private.t10_immutable_identity() RETURNS trigger
LANGUAGE plpgsql SECURITY INVOKER SET search_path = pg_catalog AS $fn$
BEGIN
  IF NEW.id IS DISTINCT FROM OLD.id OR NEW.user_id IS DISTINCT FROM OLD.user_id
     OR NEW.created_at IS DISTINCT FROM OLD.created_at THEN
    RAISE EXCEPTION 'Identidade, proprietario e data de criacao sao imutaveis' USING ERRCODE='42501';
  END IF;
  RETURN NEW;
END
$fn$;

REVOKE ALL ON FUNCTION anuncia_private.t10_immutable_identity() FROM PUBLIC, anon, authenticated;

CREATE TABLE public.clients (
  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  user_id uuid NOT NULL DEFAULT auth.uid() REFERENCES auth.users(id) ON DELETE NO ACTION,
  name text NOT NULL DEFAULT '',
  company text NOT NULL DEFAULT '',
  email text NOT NULL DEFAULT '',
  phone text NOT NULL DEFAULT '',
  tier text NOT NULL DEFAULT 'Growth' CHECK (tier IN ('Enterprise','Growth','Starter')),
  status text NOT NULL DEFAULT 'Ativo' CHECK (status IN ('Ativo','Inativo','Em onboarding')),
  mrr numeric NOT NULL DEFAULT 0,
  logo_initials text,
  since text,
  created_at timestamptz NOT NULL DEFAULT now()
);
ALTER TABLE public.clients ENABLE ROW LEVEL SECURITY;
ALTER TABLE public.clients FORCE ROW LEVEL SECURITY;
REVOKE ALL ON TABLE public.clients FROM PUBLIC, anon, authenticated;
CREATE INDEX clients_user_created_idx ON public.clients (user_id, created_at DESC);
CREATE TRIGGER a10_immutable BEFORE UPDATE ON public.clients FOR EACH ROW EXECUTE FUNCTION anuncia_private.t10_immutable_identity();

CREATE TABLE public.campaigns (
  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  user_id uuid NOT NULL DEFAULT auth.uid() REFERENCES auth.users(id) ON DELETE NO ACTION,
  name text NOT NULL DEFAULT 'Campanha sem nome',
  client_name text,
  platform text NOT NULL CHECK (platform IN ('Meta Ads','Google Ads','TikTok')),
  status text NOT NULL DEFAULT 'Rascunho' CHECK (status IN ('Ativa','Pausada','Rascunho')),
  stage text,
  goal text,
  budget numeric NOT NULL DEFAULT 0,
  spend numeric NOT NULL DEFAULT 0,
  impressions bigint NOT NULL DEFAULT 0,
  clicks bigint NOT NULL DEFAULT 0,
  conversions bigint NOT NULL DEFAULT 0,
  revenue numeric NOT NULL DEFAULT 0,
  roas_meta numeric,
  created_at timestamptz NOT NULL DEFAULT now()
);
ALTER TABLE public.campaigns ENABLE ROW LEVEL SECURITY;
ALTER TABLE public.campaigns FORCE ROW LEVEL SECURITY;
REVOKE ALL ON TABLE public.campaigns FROM PUBLIC, anon, authenticated;
CREATE INDEX campaigns_user_created_idx ON public.campaigns (user_id, created_at DESC);
CREATE TRIGGER a10_immutable BEFORE UPDATE ON public.campaigns FOR EACH ROW EXECUTE FUNCTION anuncia_private.t10_immutable_identity();

CREATE TABLE public.briefings (
  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
