-- Nao alterar ownership/defaults/triggers de storage.* geridos pelo Supabase.
-- Guards rejeitam baseline com policies preexistentes que poderiam combinar por OR.
DO $storage_guard$
BEGIN
  IF EXISTS (SELECT 1 FROM pg_catalog.pg_policies WHERE schemaname='storage' AND tablename='objects') THEN
    RAISE EXCEPTION 'storage.objects ja tem policies; auditar baseline antes de prosseguir';
  END IF;
  IF EXISTS (SELECT 1 FROM storage.buckets WHERE id IN ('midias','avatars')) THEN
    RAISE EXCEPTION 'Buckets ja existem; nao sobrescrever configuracao';
  END IF;
  IF NOT EXISTS (SELECT 1 FROM pg_catalog.pg_class c JOIN pg_catalog.pg_namespace n ON n.oid=c.relnamespace
                 WHERE n.nspname='storage' AND c.relname='objects' AND c.relrowsecurity) THEN
    RAISE EXCEPTION 'RLS de storage.objects deve existir no baseline Supabase';
  END IF;
  IF NOT has_table_privilege('authenticated','storage.objects','SELECT') OR
     NOT has_table_privilege('authenticated','storage.objects','INSERT') OR
     NOT has_table_privilege('authenticated','storage.objects','UPDATE') OR
     NOT has_table_privilege('authenticated','storage.objects','DELETE') THEN
    RAISE EXCEPTION 'Baseline de privilegios Storage deve ser revisado, nao modificado automaticamente';
  END IF;
END
$storage_guard$;

-- Lista inicial APROVADA na T10. MIME declarado nao verifica bytes/antivirus.
INSERT INTO storage.buckets (id,name,public,file_size_limit,allowed_mime_types) VALUES
 ('midias','midias',false,52428800,ARRAY['image/png','image/jpeg','image/webp','image/gif','video/mp4','video/quicktime','video/webm']::text[]),
 ('avatars','avatars',true,2097152,ARRAY['image/png','image/jpeg','image/webp']::text[]);

CREATE POLICY t10_midias_select_own ON storage.objects FOR SELECT TO authenticated
USING (bucket_id = 'midias' AND split_part(name,'/',1) = (SELECT auth.uid())::text AND split_part(name,'/',2) <> '' AND name !~ '(^|/)[.]{1,2}(/|$)' AND name !~ '//' AND right(name,1) <> '/' AND position('%' IN name) = 0 AND position(chr(92) IN name) = 0 AND name !~ '[[:cntrl:]]');

CREATE POLICY t10_midias_insert_own ON storage.objects FOR INSERT TO authenticated
WITH CHECK (bucket_id = 'midias' AND split_part(name,'/',1) = (SELECT auth.uid())::text AND split_part(name,'/',2) <> '' AND name !~ '(^|/)[.]{1,2}(/|$)' AND name !~ '//' AND right(name,1) <> '/' AND position('%' IN name) = 0 AND position(chr(92) IN name) = 0 AND name !~ '[[:cntrl:]]');

CREATE POLICY t10_midias_delete_own ON storage.objects FOR DELETE TO authenticated
USING (bucket_id = 'midias' AND split_part(name,'/',1) = (SELECT auth.uid())::text AND split_part(name,'/',2) <> '' AND name !~ '(^|/)[.]{1,2}(/|$)' AND name !~ '//' AND right(name,1) <> '/' AND position('%' IN name) = 0 AND position(chr(92) IN name) = 0 AND name !~ '[[:cntrl:]]');

CREATE POLICY t10_avatars_select_own ON storage.objects FOR SELECT TO authenticated
USING (bucket_id = 'avatars' AND name IN ((SELECT auth.uid())::text || '/avatar.png', (SELECT auth.uid())::text || '/avatar.jpg', (SELECT auth.uid())::text || '/avatar.webp') AND split_part(name,'/',1) = (SELECT auth.uid())::text AND split_part(name,'/',2) <> '' AND name !~ '(^|/)[.]{1,2}(/|$)' AND name !~ '//' AND right(name,1) <> '/' AND position('%' IN name) = 0 AND position(chr(92) IN name) = 0 AND name !~ '[[:cntrl:]]');

CREATE POLICY t10_avatars_insert_own ON storage.objects FOR INSERT TO authenticated
WITH CHECK (bucket_id = 'avatars' AND name IN ((SELECT auth.uid())::text || '/avatar.png', (SELECT auth.uid())::text || '/avatar.jpg', (SELECT auth.uid())::text || '/avatar.webp') AND split_part(name,'/',1) = (SELECT auth.uid())::text AND split_part(name,'/',2) <> '' AND name !~ '(^|/)[.]{1,2}(/|$)' AND name !~ '//' AND right(name,1) <> '/' AND position('%' IN name) = 0 AND position(chr(92) IN name) = 0 AND name !~ '[[:cntrl:]]');

CREATE POLICY t10_avatars_update_own ON storage.objects FOR UPDATE TO authenticated
USING (bucket_id = 'avatars' AND name IN ((SELECT auth.uid())::text || '/avatar.png', (SELECT auth.uid())::text || '/avatar.jpg', (SELECT auth.uid())::text || '/avatar.webp') AND split_part(name,'/',1) = (SELECT auth.uid())::text AND split_part(name,'/',2) <> '' AND name !~ '(^|/)[.]{1,2}(/|$)' AND name !~ '//' AND right(name,1) <> '/' AND position('%' IN name) = 0 AND position(chr(92) IN name) = 0 AND name !~ '[[:cntrl:]]')
WITH CHECK (bucket_id = 'avatars' AND name IN ((SELECT auth.uid())::text || '/avatar.png', (SELECT auth.uid())::text || '/avatar.jpg', (SELECT auth.uid())::text || '/avatar.webp') AND split_part(name,'/',1) = (SELECT auth.uid())::text AND split_part(name,'/',2) <> '' AND name !~ '(^|/)[.]{1,2}(/|$)' AND name !~ '//' AND right(name,1) <> '/' AND position('%' IN name) = 0 AND position(chr(92) IN name) = 0 AND name !~ '[[:cntrl:]]');

-- NENHUMA policy anon ou PUBLIC. Public URL de avatars usa o endpoint publico do Storage,
-- cujo bypass de leitura e intencional pelo bucket.public=true; listagem REST segue policies.
-- Sem novos grants sobre schemas geridos; somente buckets e policies declarados.
-- Bloqueia exclusao fisica e soft delete. Nao cria uma funcao de excluir contas.
DO $auth_guard$
BEGIN
  IF NOT EXISTS (SELECT 1 FROM pg_catalog.pg_attribute
    WHERE attrelid='auth.users'::regclass AND attname='deleted_at' AND NOT attisdropped) THEN
    RAISE EXCEPTION 'Revisar baseline Auth: deleted_at nao encontrado';
  END IF;
END
$auth_guard$;
-- SECURITY DEFINER para consultar dados com RLS durante delete administrativo.
-- Funcao privada, sem argumentos/SQL dinamico, EXECUTE revogado para API.
CREATE FUNCTION anuncia_private.t10_block_account_with_data() RETURNS trigger
LANGUAGE plpgsql SECURITY DEFINER SET search_path = pg_catalog AS $account$
BEGIN
  IF TG_OP='UPDATE' THEN
    IF NEW.deleted_at IS NULL OR NEW.deleted_at IS NOT DISTINCT FROM OLD.deleted_at THEN
      RETURN NEW;
    END IF;
  END IF;
  IF EXISTS (SELECT 1 FROM public.clients WHERE user_id=OLD.id)
     OR EXISTS (SELECT 1 FROM public.campaigns WHERE user_id=OLD.id)
     OR EXISTS (SELECT 1 FROM public.briefings WHERE user_id=OLD.id)
     OR EXISTS (SELECT 1 FROM public.commercials WHERE user_id=OLD.id)
     OR EXISTS (SELECT 1 FROM public.library_items WHERE user_id=OLD.id)
     OR EXISTS (SELECT 1 FROM public.deals WHERE user_id=OLD.id)
     OR EXISTS (SELECT 1 FROM public.assets WHERE user_id=OLD.id)
     OR EXISTS (SELECT 1 FROM public.prompts WHERE user_id=OLD.id)
     OR EXISTS (
       SELECT 1 FROM storage.objects AS o
       WHERE split_part(o.name,'/',1)=OLD.id::text
          OR to_jsonb(o)->>'owner_id'=OLD.id::text
          OR to_jsonb(o)->>'owner'=OLD.id::text
     ) THEN
    RAISE EXCEPTION 'Conta possui dados ou arquivos; exclusao automatica bloqueada' USING ERRCODE='23503';
  END IF;
  IF TG_OP='UPDATE' THEN RETURN NEW; END IF;
  RETURN OLD;
END
$account$;
REVOKE ALL ON FUNCTION anuncia_private.t10_block_account_with_data() FROM PUBLIC, anon, authenticated;
CREATE TRIGGER t10_block_account_with_data BEFORE DELETE OR UPDATE OF deleted_at ON auth.users
FOR EACH ROW EXECUTE FUNCTION anuncia_private.t10_block_account_with_data();
-- Sem cascade, exclusao de arquivos, alteracao de ownership ou criacao de usuarios.

NOTIFY pgrst, 'reload schema';

-- MODULO: CORRECAO_RLS_M16.sql.proposed
-- M16: proposta adicional para laboratorio local; aplicar somente apos validar alvo.
-- A T10 permanece imutavel. Nao exclui dados/arquivos nem altera buckets geridos.
-- Bloqueia JWT ainda valido de conta fisicamente excluida ou soft-deleted.
-- FOR SHARE serializa gravacoes com DELETE e UPDATE deleted_at da mesma conta.
DO $guard$
BEGIN
  IF current_setting('anuncia.m16_review',true) IS DISTINCT FROM 'ISOLATED_LOCAL_M16' OR current_user <> 'postgres' THEN
    RAISE EXCEPTION 'Exige alvo local M16 tecnicamente verificado';
  END IF;
  IF (SELECT count(*) FROM pg_catalog.pg_tables WHERE schemaname='public' AND tablename IN
    ('clients','campaigns','briefings','commercials','library_items','deals','assets','prompts')) <> 8 THEN
    RAISE EXCEPTION 'Baseline T10 incompleta';
  END IF;
END
$guard$;
-- Leitura: compativel com transacoes READ ONLY dos GETs do PostgREST.
CREATE FUNCTION anuncia_private.t16_active_owner() RETURNS boolean
LANGUAGE sql STABLE SECURITY DEFINER SET search_path = pg_catalog AS $read$
  SELECT EXISTS(SELECT 1 FROM auth.users AS u WHERE u.id=auth.uid() AND u.deleted_at IS NULL)
$read$;
-- Escrita: lock somente em INSERT/UPDATE, na mesma transacao da gravacao.
CREATE FUNCTION anuncia_private.t16_lock_active_owner() RETURNS boolean
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path = pg_catalog AS $fn$
DECLARE
  actor uuid := auth.uid();
  locked_actor uuid;
BEGIN
  IF actor IS NULL THEN RETURN false; END IF;
  SELECT u.id INTO locked_actor FROM auth.users AS u
    WHERE u.id=actor AND u.deleted_at IS NULL FOR SHARE;
  RETURN FOUND;
END
$fn$;
REVOKE ALL ON FUNCTION anuncia_private.t16_active_owner() FROM PUBLIC, anon;
REVOKE ALL ON FUNCTION anuncia_private.t16_lock_active_owner() FROM PUBLIC, anon;
GRANT EXECUTE ON FUNCTION anuncia_private.t16_active_owner() TO authenticated;
GRANT EXECUTE ON FUNCTION anuncia_private.t16_lock_active_owner() TO authenticated;
-- Sem novo USAGE no schema privado. Referencias nas policies sao resolvidas pelo
-- administrador na criacao; o helper so retorna booleano e nao recebe parametros.
CREATE POLICY t16_active_account ON public.clients AS RESTRICTIVE FOR ALL TO authenticated
  USING ((SELECT anuncia_private.t16_active_owner())) WITH CHECK ((SELECT anuncia_private.t16_lock_active_owner()));
CREATE POLICY t16_active_account ON public.campaigns AS RESTRICTIVE FOR ALL TO authenticated
  USING ((SELECT anuncia_private.t16_active_owner())) WITH CHECK ((SELECT anuncia_private.t16_lock_active_owner()));
CREATE POLICY t16_active_account ON public.briefings AS RESTRICTIVE FOR ALL TO authenticated
  USING ((SELECT anuncia_private.t16_active_owner())) WITH CHECK ((SELECT anuncia_private.t16_lock_active_owner()));
CREATE POLICY t16_active_account ON public.commercials AS RESTRICTIVE FOR ALL TO authenticated
  USING ((SELECT anuncia_private.t16_active_owner())) WITH CHECK ((SELECT anuncia_private.t16_lock_active_owner()));
CREATE POLICY t16_active_account ON public.library_items AS RESTRICTIVE FOR ALL TO authenticated
  USING ((SELECT anuncia_private.t16_active_owner())) WITH CHECK ((SELECT anuncia_private.t16_lock_active_owner()));
CREATE POLICY t16_active_account ON public.deals AS RESTRICTIVE FOR ALL TO authenticated
  USING ((SELECT anuncia_private.t16_active_owner())) WITH CHECK ((SELECT anuncia_private.t16_lock_active_owner()));
CREATE POLICY t16_active_account ON public.assets AS RESTRICTIVE FOR ALL TO authenticated
  USING ((SELECT anuncia_private.t16_active_owner())) WITH CHECK ((SELECT anuncia_private.t16_lock_active_owner()));
CREATE POLICY t16_active_account ON public.prompts AS RESTRICTIVE FOR ALL TO authenticated
  USING ((SELECT anuncia_private.t16_active_owner())) WITH CHECK ((SELECT anuncia_private.t16_lock_active_owner()));
CREATE POLICY t16_active_account ON storage.objects AS RESTRICTIVE FOR ALL TO authenticated
  USING ((SELECT anuncia_private.t16_active_owner())) WITH CHECK ((SELECT anuncia_private.t16_lock_active_owner()));
NOTIFY pgrst, 'reload schema';

-- MODULO: CORRECAO_STORAGE_M17.sql.proposed
-- M17: complementar T10 + M16, apenas em laboratorio local tecnicamente verificado.
-- Storage 1.19.3 finaliza uploads como role privilegiada: RLS de preflight nao basta.
-- Novo trigger independente: nao substitui triggers/defaults/ownership geridos.
DO $guard$
BEGIN
 IF current_setting('anuncia.m17_review',true) IS DISTINCT FROM 'ISOLATED_LOCAL_M17'
    OR current_user <> 'postgres' THEN
   RAISE EXCEPTION 'M17 exige verificacao externa do alvo local e executor postgres';
 END IF;
 IF NOT EXISTS (SELECT 1 FROM pg_catalog.pg_roles WHERE rolname=current_user AND rolbypassrls) THEN
   RAISE EXCEPTION 'Executor precisa BYPASSRLS para consultar Auth de forma confiavel';
 END IF;
 IF NOT EXISTS (SELECT 1 FROM pg_catalog.pg_policies WHERE schemaname='storage'
   AND tablename='objects' AND policyname='t16_active_account' AND permissive='RESTRICTIVE') THEN
   RAISE EXCEPTION 'Baseline M16 ausente';
 END IF;
 IF (SELECT count(*) FROM pg_catalog.pg_attribute WHERE attrelid='storage.objects'::regclass
     AND attname IN ('bucket_id','name','owner','owner_id') AND NOT attisdropped) <> 4 THEN
   RAISE EXCEPTION 'Baseline Storage mudou: auditar colunas de ownership antes de executar';
 END IF;
END
$guard$;
CREATE FUNCTION anuncia_private.t17_storage_active_owner() RETURNS trigger
LANGUAGE plpgsql SECURITY DEFINER SET search_path = pg_catalog AS $fn$
DECLARE
 prefix text;
 actor uuid;
 locked_actor uuid;
 max_size bigint;
 allowed_mime text[];
BEGIN
 -- Nao interferir em buckets fora do escopo T10. Nao permitir mover para fora.
 IF TG_OP='UPDATE' AND OLD.bucket_id IN ('midias','avatars') AND
    NEW.bucket_id IS DISTINCT FROM OLD.bucket_id THEN
   RAISE EXCEPTION 'M17: transferencia de bucket nao permitida' USING ERRCODE='42501';
 END IF;
 IF NEW.bucket_id NOT IN ('midias','avatars') THEN RETURN NEW; END IF;
 prefix := pg_catalog.split_part(NEW.name,'/',1);
 IF prefix IS NULL OR prefix !~ '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'
    OR NEW.owner_id IS DISTINCT FROM prefix
    OR (NEW.owner IS NOT NULL AND NEW.owner::text IS DISTINCT FROM prefix) THEN
   RAISE EXCEPTION 'M17: ownership de arquivo inconsistente' USING ERRCODE='42501';
 END IF;
 IF TG_OP='UPDATE' AND (
    pg_catalog.split_part(OLD.name,'/',1) IS DISTINCT FROM prefix
    OR OLD.owner_id IS DISTINCT FROM NEW.owner_id
    OR OLD.owner IS DISTINCT FROM NEW.owner) THEN
   RAISE EXCEPTION 'M17: transferencia de proprietario nao permitida' USING ERRCODE='42501';
 END IF;
 -- Repete a forma de caminho da T10 tambem na finalizacao privilegiada.
 IF pg_catalog.split_part(NEW.name,'/',2) = '' OR NEW.name ~ '(^|/)[.]{1,2}(/|$)'
    OR NEW.name ~ '//' OR pg_catalog.right(NEW.name,1) = '/'
    OR pg_catalog.strpos(NEW.name,'%') > 0
    OR pg_catalog.strpos(NEW.name,pg_catalog.chr(92)) > 0
    OR NEW.name ~ '[[:cntrl:]]'
    OR NEW.name ~ '(^|/)\.emptyFolderPlaceholder(/|$)' THEN
   RAISE EXCEPTION 'M17: caminho de arquivo nao permitido' USING ERRCODE='42501';
 END IF;
 IF NEW.bucket_id='avatars' AND NEW.name NOT IN
    (prefix||'/avatar.png',prefix||'/avatar.jpg',prefix||'/avatar.webp') THEN
   RAISE EXCEPTION 'M17: caminho de avatar nao permitido' USING ERRCODE='42501';
 END IF;
 -- O teste de permissao do Storage usa metadata NULL e e desfeito.
 -- A finalizacao desta versao fornece tamanho real e MIME em metadata.
 -- Nao e inspecao de bytes/antivirus e nao limita bytes em transito.
 IF NEW.metadata IS NOT NULL THEN
   IF NEW.bucket_id='avatars' THEN
     max_size := 2097152;
     allowed_mime := ARRAY['image/png','image/jpeg','image/webp'];
   ELSE
     max_size := 52428800;
     allowed_mime := ARRAY['image/png','image/jpeg','image/webp','image/gif','video/mp4','video/quicktime','video/webm'];
   END IF;
   IF pg_catalog.jsonb_typeof(NEW.metadata) IS DISTINCT FROM 'object'
      OR coalesce(NEW.metadata->>'size','') !~ '^[0-9]+$' THEN
     RAISE EXCEPTION 'M17: metadados finais invalidos' USING ERRCODE='42501';
   END IF;
   IF (NEW.metadata->>'size')::numeric > max_size
      OR ((NEW.metadata->>'mimetype') = ANY(allowed_mime)) IS DISTINCT FROM true THEN
     RAISE EXCEPTION 'M17: formato ou tamanho nao permitido' USING ERRCODE='42501';
   END IF;
 END IF;
 actor := prefix::uuid;
 -- Inclusive na finalizacao administrativa: lock fica ate COMMIT/ROLLBACK.
 -- FOR SHARE conflita com DELETE e com UPDATE de deleted_at (KEY SHARE nao basta).
 SELECT u.id INTO locked_actor FROM auth.users AS u
   WHERE u.id=actor AND u.deleted_at IS NULL FOR SHARE;
 IF NOT FOUND THEN
   RAISE EXCEPTION 'M17: conta de arquivo ausente ou excluida' USING ERRCODE='42501';
 END IF;
 RETURN NEW;
END
$fn$;
REVOKE ALL ON FUNCTION anuncia_private.t17_storage_active_owner() FROM PUBLIC, anon, authenticated;
CREATE TRIGGER t17_storage_active_owner BEFORE INSERT OR UPDATE ON storage.objects
FOR EACH ROW EXECUTE FUNCTION anuncia_private.t17_storage_active_owner();
NOTIFY pgrst, 'reload schema';

COMMIT;
