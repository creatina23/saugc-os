CREATE TABLE public.assets (
  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  user_id uuid NOT NULL DEFAULT auth.uid() REFERENCES auth.users(id) ON DELETE NO ACTION,
  name text NOT NULL DEFAULT '',
  client_name text,
  category text NOT NULL CHECK (category IN ('Video Ads','Hook Clips','B-Roll','Product Photos')),
  format text NOT NULL,
  size_bytes bigint NOT NULL CHECK (size_bytes >= 0),
  tags text[] NOT NULL DEFAULT '{}'::text[],
  storage_path text CHECK (storage_path IS NULL OR (split_part(storage_path,'/',1) = user_id::text AND position('/' IN storage_path) > 0 AND split_part(storage_path,'/',2) <> '' AND storage_path !~ '(^|/)[.]{1,2}(/|$)' AND storage_path !~ '//' AND right(storage_path,1) <> '/' AND position('%' IN storage_path) = 0 AND position(chr(92) IN storage_path) = 0 AND storage_path !~ '[[:cntrl:]]')),
  created_at timestamptz NOT NULL DEFAULT now()
);
ALTER TABLE public.assets ENABLE ROW LEVEL SECURITY;
ALTER TABLE public.assets FORCE ROW LEVEL SECURITY;
REVOKE ALL ON TABLE public.assets FROM PUBLIC, anon, authenticated;
CREATE INDEX assets_user_created_idx ON public.assets (user_id, created_at DESC);
CREATE TRIGGER a10_immutable BEFORE UPDATE ON public.assets FOR EACH ROW EXECUTE FUNCTION anuncia_private.t10_immutable_identity();

